# Canonical origin, used for canonical tags, the sitemap, OG image URLs and
# every absolute URL in the JSON-LD. Leave unset in production: it defaults to
# https://longitivity.com in lib/seo.ts. Only set this for a preview deployment
# that should point at itself rather than at the live domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Copy this file to .env.local and fill in your Supabase project's API config.
# Found in Supabase Dashboard > Project Settings > API. Run supabase/leads.sql
# in the SQL Editor first to create the table these write to.
# Safe to expose to the browser (NEXT_PUBLIC_) — access is controlled by the
# "leads" table's Row Level Security policy, not secrecy of this key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for the /schedule booking system (supabase/bookings.sql).
# Secret — never expose this to the browser. It bypasses Row Level Security
# entirely, which is intentional: the bookings table holds customer PII
# (name, email, phone, address) and has no anon policy at all, so only
# server-side API routes using this key can read or write it. Found in
# Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) sends a real-time email notification to yourself every
# time someone submits the contact form, plus the booking confirmation email
# sent to customers from /schedule. Secret — never expose this one to the
# browser. Create it under Resend > API Keys.
RESEND_API_KEY=

# Optional: which inbox gets notified. Defaults to CONTACT.email in
# lib/site-config.ts if unset.
LEAD_NOTIFY_EMAIL=

# Optional: sender identity for the notification email, e.g.
# "Longitivity Leads <leads@yourdomain.com>". Requires verifying yourdomain.com
# under Resend > Domains. Without a verified domain, this falls back to
# Resend's shared "onboarding@resend.dev" sender, which only delivers to the
# email address on your own Resend account — fine for testing, not for real
# leads.
RESEND_FROM_EMAIL=
